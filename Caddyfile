# Caddy раздаёт static export. HTTPS снаружи терминирует Traefik (Dokploy),
# поэтому слушаем обычный :80 без авто-TLS.
:80 {
	root * /srv
	encode zstd gzip

	# Хешированные ассеты Next иммутабельны — кэшируем надолго.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Static export: пробуем файл, затем .html, иначе кастомная 404.
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
